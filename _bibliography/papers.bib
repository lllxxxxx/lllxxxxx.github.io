  title       = {Can Decision Models Understand Stance? Evaluating Jev Against General-Purpose LLMs},
  author      = {Li, Xing and Ning, Jinzhong and Zhang, Yijia and Yang, Liang and Lin, Hongfei},
  journal     = {arXiv preprint arXiv:2610.11901},
  year        = {2026},
  arxiv       = {2610.11901},
  pdf         = {https://arxiv.org/pdf/2610.11901},
  abstract    = {We evaluate Jev, a decision model that returns probability distributions over predefined options, on two stance detection datasets: VAST (English texts) and ZS-CSD (Chinese conversations). Compared with four general-purpose LLMs and two fine-tuned models, Jev performs on par with GPT-5.6 on VAST but falls behind stronger LLMs on ZS-CSD, especially in distinguishing favor from against.}
